    "expo-status-bar": "^3.0.0",
    "expo-system-ui": "~6.0.9",
    "react": "^19.1.0",
    "react-native": "^0.81.4",
    "react-native-webview": "^13.17.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.9.3"
  }
