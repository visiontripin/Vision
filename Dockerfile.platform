# Development-only image for the isolated v2 API. It does not contain the legacy
# SQLite API, browser app, Windows service manager, or media-processing workers.
FROM node:22.22.3-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --omit=optional --ignore-scripts --workspaces=false \
    && npm cache clean --force
COPY services/api/src ./services/api/src

ENV NODE_ENV=production \
    PLATFORM_HOST=0.0.0.0 \
    PLATFORM_PORT=4400
EXPOSE 4400
USER node
CMD ["node", "services/api/src/platform/start.js"]
